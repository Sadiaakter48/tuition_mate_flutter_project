rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isWorkspaceOwner(userId) {
      return request.auth != null
          && request.auth.uid == userId
          && get(/databases/$(database)/documents/users/$(userId)).data.role == 'owner';
    }

    function isWorkspaceMember(userId) {
      return request.auth != null
          && (request.auth.uid == userId
              || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.workspaceId == userId
                  && get(/databases/$(database)/documents/users/$(userId)/members/$(request.auth.uid)).data.active == true));
    }

    function isLinkedGuardian(userId, studentId) {
      return request.auth != null
          && request.auth.token.email_verified == true
          && get(/databases/$(database)/documents/users/$(userId)/students/$(studentId)).data.guardianUid == request.auth.uid;
    }

    function isGuardianOfGroup(userId, groupId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null
          && request.auth.token.email_verified == true
          && profile.linkedTeacherUid == userId
          && isLinkedGuardian(userId, profile.linkedStudentId)
          && get(/databases/$(database)/documents/users/$(userId)/students/$(profile.linkedStudentId)).data.batchId == groupId;
    }

    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if isWorkspaceOwner(userId);

      match /members/{memberUid} {
        allow read: if isWorkspaceOwner(userId)
                    || (request.auth != null && request.auth.uid == memberUid);
        allow create, update, delete: if isWorkspaceOwner(userId);
      }

      match /students/{studentId} {
        allow read: if isWorkspaceMember(userId) || isLinkedGuardian(userId, studentId);
        allow create, update, delete: if isWorkspaceMember(userId);
      }

      match /classSessions/{sessionId} {
        allow read: if isWorkspaceMember(userId)
                    || isLinkedGuardian(userId, resource.data.studentId);
        allow create, update, delete: if isWorkspaceMember(userId);
      }

      match /learningTasks/{taskId} {
        allow read: if isWorkspaceMember(userId)
                    || isLinkedGuardian(userId, resource.data.studentId);
        allow create, update, delete: if isWorkspaceMember(userId);
      }

      match /teachingGroups/{groupId} {
        allow read: if isWorkspaceMember(userId)
                    || isGuardianOfGroup(userId, groupId);
        allow create, update, delete: if isWorkspaceMember(userId);
      }

      match /reminderLogs/{logId} {
        allow read: if isWorkspaceMember(userId);
        allow write: if false;
      }
    }

    match /guardianInvites/{inviteId} {
      allow read, write: if false;
    }

    match /teacherInvites/{inviteId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
